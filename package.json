{
  "name": "maido-ookini",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:rules && npm run test:data",
    "test:watch": "vitest --project unit",
    "emulators": "firebase emulators:start --project demo-maido-ookini",
    "build:dev": "tsc -b && node scripts/build.mjs development",
    "test:unit": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-maido-ookini \"vitest run --project rules\"",
    "test:data": "firebase emulators:exec --only firestore --project demo-maido-ookini \"vitest run --project data\""
  },
  "dependencies": {
    "@fontsource/zen-kurenaido": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "firebase": "^12.19.0",
    "preact": "^11.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
