{
  "name": "maido-ookini",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --project demo-maido-ookini",
    "build:dev": "tsc -b && node scripts/build.mjs development"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "firebase": "^12.19.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
